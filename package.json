{
  "name": "smitharia-astro",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 ",
    "start": "astro dev --host 0.0.0.0 ",
    "build": "astro check && astro build && node scripts/prepare-limited-hosting.mjs",
    "test:limited": "node --test functions/test/*.test.js && php wordpress/wp-content/plugins/smitharia-core/tests/limited-access-test.php",
    "preview": "astro preview",
    "astro": "astro",
    "lint:precommit": "eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "fmt:precommit": "prettier -l './**/*.{js,jsx,ts,tsx,json,css,scss}'"
  },
  "dependencies": {
    "@astrojs/check": "^0.4.1",
    "@astrojs/node": "^8.1.0",
    "@astrojs/react": "^3.0.9",
    "@astrojs/sitemap": "^3.1.4",
    "@astrojs/tailwind": "^5.1.0",
    "@fontsource/libre-caslon-display": "^5.0.18",
    "@fontsource/libre-caslon-text": "^5.0.18",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "astro": "^4.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@astrojs/partytown": "^2.0.4",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unicorn": "56.0.1",
    "globals": "16.5.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "prettier-plugin-astro": "^0.13.0",
    "swiper": "^11.0.5",
    "typescript-eslint": "8.48.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "npm run lint:precommit",
    "src/**/*.{astro,js,jsx,ts,tsx,json,css,scss}": "npm run fmt:precommit"
  }
}
