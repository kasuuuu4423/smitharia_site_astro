---
import Layout from '../../layouts/Layout.astro';
import logo from '../../assets/images/smitharia_logo.svg';
import { getAllWorks } from '../../lib/WP';
import { decodeHtmlEscape } from '../../lib/Util';
import HeroSlider from '../../components/top/HeroSlider';
import ToggleFilteredImage, {
  parentClass as imageEffectClass,
} from '../../components/common/ToggleFilteredImage.astro';

interface Props {
  limited?: boolean;
}
const { limited = false } = Astro.props;
const urlPrefix = limited ? '/limited' : '';
const works = (await getAllWorks(limited ? 'include' : 'exclude')).filter(
  (work) => limited || !work.acf.limited
);
const limitedWorks = limited ? works.filter((work) => work.acf.limited) : [];
const heroWorks = [51, 454, 837].flatMap((id) => {
  const work = works.find((item) => item.id === id);
  return work ? [work] : [];
});
const selection = [
  { id: 579, type: 'Live visuals' },
  { id: 454, type: 'Sound installation' },
  { id: 837, type: 'Lighting / Music video' },
];
const selectedWorks = selection.flatMap((item) => {
  const work = works.find((work) => work.id === item.id);
  return work ? [{ work, type: item.type }] : [];
});
---

<Layout title="" pagename="" home limited={limited}>
  <a class="skipLink" href="#homeContent">本文へ移動</a>
  <header class="homeHeader font-serif">
    <a href={`${urlPrefix}/`} aria-label="smitharia トップページ"
      ><img src={logo.src} alt="smitharia" width="150" height="28" /></a
    >
    <nav aria-label="サイト内ナビゲーション">
      <a href={`${urlPrefix}/works/`}>works</a>
      <a href={`${urlPrefix}/aboutus/`}>about us</a>
      <a href="#contact">contact</a>
    </nav>
  </header>
  <main id="homeContent" class="homePage font-serif">
    <section class="homeHero" aria-labelledby="homeTitle">
      <HeroSlider works={heroWorks} limited={limited} client:load />
      <div class="heroShade" aria-hidden="true"></div>
      <div class="heroIdentity">
        <h1 id="homeTitle"><img src={logo.src} alt="smitharia" width="750" height="140" /></h1>
        <p>Creative platform</p>
      </div>
      <div class="heroBottom">
        <p class="heroNote">Live / Installation / Moving image</p>
      </div>
      <a class="scrollHint" href="#introduction" aria-label="smithariaの紹介へ"
        ><span aria-hidden="true">↓</span></a
      >
    </section>
    <section id="introduction" class="homeIntro homeSection" aria-labelledby="introTitle">
      <p class="sectionLabel">
        スミサリアについて<span class="translation" lang="en">about smitharia</span>
      </p>
      <div>
        <h2 id="introTitle">演出を仕組みからつくる。</h2>
        <p class="englishText translation" lang="en">Creating the systems behind the experience.</p>
        <p class="introText">
          音に反応する光やゲームで操作する映像。<br />
          表現に合わせた仕組みをつくり<br />
          ライブや展示の企画・演出を手がけています。
        </p>
        <p class="englishText translation" lang="en">
          Light that responds to sound. Visuals controlled through games.<br />
          We build systems to suit each creative idea,<br />
          and plan and direct live events and exhibitions.
        </p>
        <a class="textLink" href={`${urlPrefix}/aboutus/`}
          >about us <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
    <section class="homeWorks homeSection" aria-labelledby="selectedTitle">
      <div class="sectionHeader">
        <h2 id="selectedTitle">
          主な制作実績<span class="translation" lang="en">selected works</span>
        </h2>
        <a class="textLink" href={`${urlPrefix}/works/`}
          >all works <span aria-hidden="true">↗</span></a
        >
      </div>
      <div class="selectedGrid">
        {
          selectedWorks.map(({ work, type }, index) => (
            <a
              class:list={['selectedWork', imageEffectClass, { wideWork: index === 2 }]}
              href={`${urlPrefix}/work/${work.id}/`}
            >
              <div class="workImage">
                <ToggleFilteredImage imgPath={work.acf.thumbnail.url} alt="" />
              </div>
              <div class="workCaption">
                <>
                  <h3>{decodeHtmlEscape(work.title.rendered)}</h3>
                  <span aria-hidden="true">↗</span>
                </>
              </div>
              <p class="workType">{type}</p>
            </a>
          ))
        }
      </div>
    </section>
    {
      limitedWorks.length > 0 && (
        <section class="homeWorks homeSection" aria-labelledby="limitedTitle">
          <div class="sectionHeader">
            <h2 id="limitedTitle">
              限定公開の制作実績
              <span class="translation" lang="en">
                private works
              </span>
            </h2>
            <a class="textLink" href={`${urlPrefix}/works/`}>
              all works <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="selectedGrid">
            {limitedWorks.map((work) => (
              <a
                class:list={['selectedWork', imageEffectClass]}
                href={`${urlPrefix}/work/${work.id}/`}
              >
                <div class="workImage">
                  <ToggleFilteredImage imgPath={work.acf.thumbnail.url} alt="" />
                </div>
                <div class="workCaption">
                  <h3>{decodeHtmlEscape(work.title.rendered)}</h3>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
    <section id="contact" class="homeContact homeSection" aria-labelledby="homeContactTitle">
      <div>
        <h2 id="homeContactTitle">
          制作のご相談<span class="translation" lang="en">contact</span>
        </h2>
        <p>企画や制作のご相談はこちらへ。</p>
        <p class="englishText translation" lang="en">Get in touch to discuss your project.</p>
      </div>
      <a class="contactMail" href="mailto:info@smitharia.com"
        >info@smitharia.com <span aria-hidden="true">↗</span></a
      >
    </section>
    <div class="homeFooter homeSection">
      <p>© smitharia</p>
      <div>
        <a href="https://www.instagram.com/__smitharia" target="_blank" rel="noopener noreferrer"
          >Instagram <span class="sr-only">（新しいタブで開く）</span></a
        ><a href="https://twitter.com/__smitharia" target="_blank" rel="noopener noreferrer"
          >X <span class="sr-only">（新しいタブで開く）</span></a
        >
      </div>
    </div>
  </main>
</Layout>

<style>
  .homePage {
    --homeText: #f2f0eb;
    --homeMuted: #b9b8b4;
    --homeBorder: #555550;
    color: var(--homeText);
    font-weight: 400;
  }
  .englishText,
  .homeContact .englishText {
    margin-top: 16px;
    max-width: 38em;
  }
  .sectionLabel,
  .sectionHeader h2,
  .homeContact h2 {
    color: var(--brandRedText);
  }
  .textLink span,
  .workCaption > span,
  .contactMail span {
    color: var(--brandGreen);
  }
  .homeHeader nav a:hover,
  .homeHeader nav a:focus-visible,
  .homeFooter a:hover,
  .homeFooter a:focus-visible,
  .textLink:hover,
  .textLink:focus-visible,
  .contactMail:hover,
  .contactMail:focus-visible {
    color: var(--brandGreen);
  }
  .sectionLabel .translation,
  .sectionHeader h2 .translation,
  .homeContact h2 .translation {
    display: block;
    margin-top: 8px;
  }
  .skipLink {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 60;
    padding: 12px;
    color: #111;
    background: white;
    transform: translateY(-150%);
  }
  .skipLink:focus {
    transform: translateY(0);
  }
  .homeHeader {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 32px 5vw;
    color: white;
  }
  .homeHeader > a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .homeHeader > a img {
    width: 150px;
    height: auto;
  }
  .homeHeader nav {
    display: flex;
    gap: clamp(12px, 3vw, 48px);
  }
  .homeHeader nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    font-size: 16px;
  }
  .homeHeader a:hover,
  .homeFooter a:hover {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .homeHero {
    position: relative;
    min-height: 640px;
    height: 100svh;
    isolation: isolate;
    background: #080809;
    overflow: hidden;
  }
  .heroShade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .heroShade {
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.65), transparent 56%, rgba(0, 0, 0, 0.78));
  }
  .heroIdentity {
    z-index: 2;
    pointer-events: none;
    position: absolute;
    top: 22%;
    left: 5vw;
    right: 5vw;
    animation: identityEntrance 0.8s ease-out both;
  }
  .heroIdentity h1 {
    max-width: 780px;
  }
  .heroIdentity h1 img {
    width: 100%;
    height: auto;
  }
  .heroIdentity p {
    margin-top: 22px;
    font-size: 17px;
    letter-spacing: 0.15em;
  }
  .heroBottom {
    z-index: 2;
    pointer-events: none;
    position: absolute;
    bottom: 54px;
    left: 5vw;
    right: 5vw;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  .heroNote {
    font-size: 15px;
    line-height: 1.8;
  }
  .scrollHint {
    z-index: 3;
    position: absolute;
    bottom: 8px;
    left: calc(50% - 22px);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    font-size: 24px;
  }
  .homeSection {
    margin-inline: auto;
    width: min(90%, 1280px);
  }
  .homeIntro {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    padding-block: clamp(80px, 10vw, 160px);
  }
  .sectionLabel {
    font-size: 17px;
    padding-top: 8px;
  }
  .homeIntro h2 {
    font-size: clamp(24px, 3vw, 42px);
    font-weight: 400;
    line-height: 1.9;
    letter-spacing: 0.08em;
  }
  .introText {
    text-wrap: pretty;
    margin-top: 32px;
    font-size: 16px;
    line-height: 2.2;
    color: var(--homeText);
  }
  .textLink {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    min-height: 44px;
    font-size: 17px;
  }
  .homeIntro .textLink {
    margin-top: 26px;
  }
  .textLink span,
  .workCaption > span,
  .contactMail span {
    transition: transform 0.2s ease;
  }
  .textLink:hover span,
  .selectedWork:hover .workCaption > span,
  .contactMail:hover span {
    transform: translate(3px, -3px);
  }
  .sectionHeader {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-bottom: 40px;
    border-top: 1px solid var(--homeBorder);
    padding-top: 28px;
  }
  .sectionHeader h2 {
    font-size: clamp(26px, 3vw, 40px);
  }
  .selectedGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px 5%;
    align-items: start;
  }
  .selectedWork:nth-child(2) {
    margin-top: 110px;
  }
  .wideWork {
    grid-column: 1 / -1;
    width: 76%;
  }
  .workImage {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #121212;
  }
  .wideWork .workImage {
    aspect-ratio: 16 / 9;
  }
  .workImage > :global(.toggle_image) {
    position: absolute;
    inset: 0;
  }
  .workImage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity 1s cubic-bezier(0, 0.3, 0, 0.9),
      transform 0.4s ease;
  }
  .selectedWork:hover :global(img.normal),
  .selectedWork:focus-visible :global(img.normal) {
    opacity: 0;
  }
  .selectedWork:hover :global(img) {
    transform: scale(1.025);
  }
  .workCaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 18px;
    font-size: 19px;
    line-height: 1.6;
  }
  .workCaption h3 {
    overflow-wrap: anywhere;
  }
  .workType {
    margin-top: 6px;
    color: var(--homeMuted);
    font-size: 14px;
  }
  .homeContact {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-top: 120px;
    padding-block: 56px;
    border-top: 1px solid var(--homeBorder);
    border-bottom: 1px solid var(--homeBorder);
  }
  .homeContact h2 {
    font-size: 32px;
  }
  .homeContact p:not(.translation) {
    margin-top: 16px;
    font-size: 16px;
    color: var(--homeText);
  }
  .contactMail {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 44px;
    font-size: clamp(20px, 3vw, 36px);
    letter-spacing: 0.02em;
  }
  .homeFooter {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-block: 36px;
    font-size: 13px;
    color: var(--homeMuted);
  }
  .homeFooter > div {
    display: flex;
    gap: 24px;
  }
  .homeFooter a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @keyframes identityEntrance {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 767px) {
    .homeHeader {
      padding: 20px 5vw;
      gap: 16px;
    }
    .homeHeader > a img {
      width: 104px;
    }
    .homeHeader nav {
      gap: 14px;
    }
    .homeHeader nav a {
      font-size: 14px;
      letter-spacing: 0.02em;
    }
    .homeHero {
      min-height: 560px;
    }
    .heroIdentity {
      top: 21%;
    }
    .heroIdentity p {
      font-size: 14px;
      margin-top: 18px;
    }
    .heroBottom {
      bottom: 156px;
      display: block;
    }
    .heroNote {
      font-size: 13px;
    }
    .homeIntro {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .sectionLabel {
      font-size: 15px;
    }
    .homeIntro h2 {
      font-size: clamp(21px, 5.6vw, 30px);
    }
    .introText {
      font-size: 15px;
      line-height: 2;
      margin-top: 24px;
    }
    .sectionHeader {
      margin-bottom: 28px;
    }
    .selectedGrid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .selectedWork:nth-child(2) {
      margin-top: 0;
    }
    .wideWork {
      width: 100%;
    }
    .workCaption {
      font-size: 17px;
    }
    .homeContact {
      display: block;
      margin-top: 80px;
      padding-block: 36px;
    }
    .contactMail {
      margin-top: 24px;
      font-size: clamp(18px, 5.5vw, 28px);
      gap: 12px;
    }
    .homeFooter {
      font-size: 12px;
    }
  }
</style>
