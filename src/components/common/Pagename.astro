---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<div
  class="pagename px-6 mb-8 md:p-0 md:mb-0 md:fixed md:z-10 md:mt-20 md:mr-20 md:top-0 md:right-0 md:pointer-events-none"
>
  <div class="textbox tracking-widest text-4xl font-black text-white">{name}</div>
</div>
<style>
  @media (min-width: 768px) {
    .textbox {
      writing-mode: vertical-rl;
      font-size: clamp(48px, min(12vw, 10vh), 96px);
    }
  }
</style>
