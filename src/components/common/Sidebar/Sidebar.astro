---
import { Image } from 'astro:assets';
import logoImage from '../../../assets/images/smitharia_logo.svg';
import noiseImage from '../../../assets/images/noise.jpg';
import { getCats } from '../../../lib/WP.ts';
import Category from './Category.astro';
interface Props {
  limited?: boolean;
}
const { limited } = Astro.props;
const cats = await getCats();
const homeUrl = limited ? '/limited/' : '/';
---

<div
  id="siteSidebar"
  class="siteSidebar w-full fixed top-0 md:static z-30"
  style={`--menu-background: url(${noiseImage.src})`}
>
  <div class="mobileHeader md:hidden flex justify-between items-center relative">
    <a href={homeUrl} aria-label="smitharia トップページ"
      ><Image class="w-36" src={logoImage} alt="smitharia" /></a
    >
    <button
      id="hamburger"
      type="button"
      class="menuToggle"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="siteNavigation"
    >
      <span class="menuIcon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="jsMenuLabel text-sm">MENU</span>
    </button>
  </div>
  <nav
    id="siteNavigation"
    aria-label="サイト内ナビゲーション"
    class="siteNavigation sticky top-16 hidden md:block"
  >
    <a class="hidden md:block mb-12" href={homeUrl} aria-label="smitharia トップページ"
      ><Image src={logoImage} alt="smitharia" /></a
    >
    <div class="px-6 md:px-0 md:ml-6 text-xl md:text-base">
      {
        cats?.works?.length > 0 && (
          <Category
            urlPrefix={limited ? 'limited/' : ''}
            title="works"
            titleUrl={limited ? '/limited/works/' : '/works/'}
            subcats={cats.works}
          />
        )
      }
      {
        cats?.studies?.length > 0 && (
          <Category urlPrefix={limited ? 'limited/' : ''} title="studies" subcats={cats.studies} />
        )
      }
      {
        cats?.artists?.length > 0 && (
          <Category
            urlPrefix={limited ? 'limited/' : ''}
            title="member tags"
            subcats={cats.artists}
          />
        )
      }
      <a class="block py-2 text-white" href={`${homeUrl}aboutus`}>about us</a>
    </div>
  </nav>
</div>
<style>
  .mobileHeader {
    padding: 1.5rem;
    background-image: var(--menu-background);
    background-size: cover;
  }
  .menuToggle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 48px;
    min-height: 56px;
    color: white;
  }
  .menuIcon {
    position: relative;
    display: block;
    width: 25px;
    height: 25px;
  }
  .menuIcon span {
    position: absolute;
    left: 0;
    width: 25px;
    height: 2px;
    background: white;
    transition: 4s;
    transition-timing-function: cubic-bezier(0, 1, 0, 1);
  }
  .menuIcon span:nth-child(1) {
    top: 0;
  }
  .menuIcon span:nth-child(2) {
    top: 50%;
    transform: translateY(-50%);
  }
  .menuIcon span:nth-child(3) {
    bottom: 0;
  }
  [aria-expanded='true'] .menuIcon span:nth-child(1) {
    top: 50%;
    transform: rotate(45deg);
    background: #2f4fff;
  }
  [aria-expanded='true'] .menuIcon span:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded='true'] .menuIcon span:nth-child(3) {
    top: 50%;
    transform: rotate(-45deg);
    background: #ff2e2e;
  }
  @media (min-width: 768px) {
    .siteNavigation {
      max-height: calc(100dvh - 6rem);
      overflow-y: auto;
      padding: 6px;
      margin: -6px;
    }
  }
  @media (max-width: 767px) {
    .siteSidebar.menuOpen {
      inset: 0;
      height: 100dvh;
      background-image: var(--menu-background);
      background-size: cover;
      display: flex;
      flex-direction: column;
    }
    .menuOpen .siteNavigation {
      position: static;
      overflow-y: auto;
      flex: 1;
      padding-block: 1rem 3rem;
    }
  }
</style>
<script>
  const sidebar = document.getElementById('siteSidebar');
  const toggle = document.getElementById('hamburger');
  const navigation = document.getElementById('siteNavigation');
  const menuLabel = sidebar?.querySelector('.jsMenuLabel');
  const mobileQuery = window.matchMedia('(max-width: 767px)');
  let menuOpen = false;
  let previousOverflow = '';
  let backgroundElements: { element: HTMLElement; inert: boolean }[] = [];

  const setMenuOpen = (open: boolean, restoreFocus = true) => {
    if (!sidebar || !toggle || !navigation || menuOpen === open) return;
    menuOpen = open;
    sidebar.classList.toggle('menuOpen', open);
    navigation.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    if (menuLabel) menuLabel.textContent = open ? 'CLOSE' : 'MENU';
    if (open) {
      sidebar.setAttribute('role', 'dialog');
      sidebar.setAttribute('aria-modal', 'true');
      sidebar.setAttribute('aria-label', 'サイトメニュー');
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      let ancestor: HTMLElement = sidebar;
      while (ancestor.parentElement) {
        for (const sibling of ancestor.parentElement.children) {
          if (sibling instanceof HTMLElement && sibling !== ancestor) {
            backgroundElements.push({ element: sibling, inert: sibling.inert });
            sibling.inert = true;
          }
        }
        ancestor = ancestor.parentElement;
        if (ancestor === document.body) break;
      }
      navigation.querySelector<HTMLButtonElement>('.jsCategoryToggle')?.focus();
    } else {
      sidebar.removeAttribute('role');
      sidebar.removeAttribute('aria-modal');
      sidebar.removeAttribute('aria-label');
      for (const { element, inert } of backgroundElements) element.inert = inert;
      backgroundElements = [];
      document.body.style.overflow = previousOverflow;
      if (restoreFocus) toggle.focus();
    }
  };

  toggle?.addEventListener('click', () => setMenuOpen(!menuOpen));
  sidebar?.addEventListener('keydown', (event) => {
    if (!menuOpen) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      setMenuOpen(false);
    }
    if (event.key !== 'Tab') return;
    const focusable = [...sidebar.querySelectorAll<HTMLElement>('a[href], button')].filter(
      (element) => element.getClientRects().length > 0
    );
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
  sidebar?.querySelectorAll<HTMLButtonElement>('.jsCategoryToggle').forEach((button) => {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(expanded));
      document
        .getElementById(button.getAttribute('aria-controls') ?? '')
        ?.classList.toggle('hidden', !expanded);
    });
  });
  mobileQuery.addEventListener('change', () => setMenuOpen(false, false));
</script>
