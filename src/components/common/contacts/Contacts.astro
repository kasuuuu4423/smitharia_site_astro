---
import ContactItem from './ContactItem.astro';
---

<div
  class="contacts mx-6 my-12 md:mx-0 md:my-0 md:fixed md:z-10 md:mb-[40px] md:mr-28 md:bottom-0 md:right-0"
>
  <div class="text-white text-sm leading-relaxed tracking-wider">
    <ContactItem
      icon_cat="brands"
      icon="square-twitter"
      text="__smitharia"
      url="https://twitter.com/__smitharia"
    />
    <ContactItem
      icon_cat="brands"
      icon="instagram"
      text="__smitharia"
      url="https://www.instagram.com/__smitharia"
    />
    <ContactItem
      icon_cat="regular"
      icon="envelope"
      text="info@smitharia.com"
      url="mailto:info@smitharia.com"
    />
    <div class="text-right">©smitharia.com</div>
  </div>
</div>

