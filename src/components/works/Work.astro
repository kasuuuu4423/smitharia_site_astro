---
import { type Work } from '../../lib/WP';
import { decodeHtmlEscape } from '../../lib/Util';
import ToggleFilteredImage, { parentClass } from '../common/ToggleFilteredImage.astro';
interface Props {
  work: Work;
  limited?: boolean;
}
const { work, limited } = Astro.props;
const workClass = `${parentClass} min-w-0 mb-12 md:mb-0 ${work.acf.extend_column ? 'col-span-2' : ''} ${work.acf.extend_row ? 'row-span-2' : ''}`;
---

<div class={workClass}>
  <a class="flex h-full flex-col text-white" href={`${limited ? '/limited' : ''}/work/${work.id}`}>
    <div
      class="relative [&>.toggle_image]:absolute [&>.toggle_image]:inset-0 h-[300px] md:min-h-[200px] md:h-auto md:flex-1 overflow-hidden"
    >
      <ToggleFilteredImage imgPath={work.acf.thumbnail.url} alt="" />
    </div>
    <h2 class="px-6 md:px-0 py-3 text-base leading-relaxed font-serif">
      {decodeHtmlEscape(work.title.rendered)}
    </h2>
  </a>
</div>
