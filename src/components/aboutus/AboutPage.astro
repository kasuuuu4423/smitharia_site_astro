---
import Layout from '../../layouts/Layout.astro';
import Members from '../../components/aboutus/Members.astro';
import ToggleFilteredImage from '../../components/common/ToggleFilteredImage.astro';
import { parentClass as imgParentClass } from '../../components/common/ToggleFilteredImage.astro';
import { decodeHtmlEscape } from '../../lib/Util';
import { getPreference, getWorks } from '../../lib/WP';

interface Props {
  limited?: boolean;
}
const { limited = false } = Astro.props;
const urlPrefix = limited ? '/limited' : '';
const [pref, works] = await Promise.all([
  getPreference(),
  getWorks({ per_page: '100', limited: limited ? 'include' : 'exclude' }),
]);
const aboutImage = pref.acf.about_image.sizes.medium_large;
const alt = pref.acf.about_image.alt;
const activities = [
  {
    label: 'Live event planning / Direction',
    title: 'ライブの企画・演出',
    description:
      'ステージプランから映像制作・VJ、当日のテクニカル管理まで。音に反応する映像やバトル用のタイマーなど演出に必要なシステムも開発します。',
    englishDescription:
      'From stage planning, video production and VJ performances to technical management on the day, we also develop the systems each event needs, including sound-reactive visuals and timers for battles.',
    workId: 771,
    credit: '主催陣として企画の一部と演出全般を担当',
    englishCredit: 'Co-organizer responsible for part of the planning and all creative direction',
  },
  {
    label: 'Exhibition / Installation',
    title: '展示・インスタレーション',
    description:
      '楽曲を光や造形で表す展示や天候によって変わる光の作品を制作しています。展示の企画や技術面の設計・設営も手がけています。',
    englishDescription:
      'We create exhibitions that translate music into light and physical forms, as well as light-based works that change with the weather. We also handle exhibition planning, technical design and installation.',
    workId: 447,
    credit: '企画・テクニカルディレクション・グラフィックデザイン・技術サポート',
    englishCredit: 'Planning / Technical direction / Graphic design / Technical support',
  },
  {
    label: 'Moving image production',
    title: '映像制作',
    description:
      'MVやプロモーション映像、モーショングラフィックスを制作します。3DCGや音楽の制作に加えて、音に反応する照明などのインタラクティブなシステムも開発しています。',
    englishDescription:
      'We produce music videos, promotional videos and motion graphics. Alongside 3D CG and music production, we develop interactive systems such as sound-reactive lighting.',
    workId: 837,
    credit: 'アートディレクション・照明システムの開発と設置',
    englishCredit: 'Art direction / Lighting system development and installation',
  },
].map((activity) => ({
  ...activity,
  work: works.find((work) => work.id === activity.workId && (limited || !work.acf.limited)),
}));
---

<Layout title="about us" pagename="about us" limited={limited}>
  <main class="aboutContent w-full md:pl-16 text-white font-serif">
    <section class="aboutHero aboutInset" aria-labelledby="aboutTitle">
      <div class="aboutIntroduction">
        <h1 id="aboutTitle">演出を仕組みからつくる。</h1>
        <p class="englishText translation" lang="en">Creating the systems behind the experience.</p>
        <p>
          <span>音に反応する光や</span><span>ゲームで操作する映像。</span><br />
          表現に合わせた仕組みをつくり<br />
          <span>ライブや展示の企画・演出を</span><span>手がけています。</span>
        </p>
        <p class="englishText translation" lang="en">
          Light that responds to sound. Visuals controlled through games.<br />
          We build systems to suit each creative idea,<br />
          and plan and direct live events and exhibitions.
        </p>
      </div>
      <figure class="aboutLandscape">
        <div class:list={['landscapeImage', imgParentClass]}>
          <ToggleFilteredImage imgPath={aboutImage} alt={alt} reverse />
        </div>
        <figcaption>
          <span>スミサリアの原風景</span>
          <span class="translation" lang="en">The landscape that inspired smitharia.</span>
        </figcaption>
      </figure>
    </section>
    <section class="activities aboutInset mb-24" aria-labelledby="activitiesTitle">
      <h2 id="activitiesTitle" class="sectionLabel">
        活動内容<span class="translation" lang="en">what we do</span>
      </h2>
      {
        activities.map(
          ({ label, title, description, englishDescription, work, credit, englishCredit }) => (
            <article class="activity">
              <div class="activityText">
                <h3>
                  {title}
                  <span class="activityLabel translation" lang="en">
                    {label}
                  </span>
                </h3>
                <p class="activityDescription">{description}</p>
                <p class="englishText translation" lang="en">
                  {englishDescription}
                </p>
              </div>
              {work && (
                <a
                  class:list={['activityWork', imgParentClass]}
                  href={`${urlPrefix}/work/${work.id}/`}
                >
                  <div class="activityImage">
                    <ToggleFilteredImage imgPath={work.acf.thumbnail.url} alt="" />
                  </div>
                  <div class="workCaption">
                    <span>{decodeHtmlEscape(work.title.rendered)}</span>
                    <span aria-hidden="true">↗</span>
                  </div>
                  <p class="workCredit">{credit}</p>
                  <p class="workCredit englishCredit translation" lang="en">
                    {englishCredit}
                  </p>
                </a>
              )}
            </article>
          )
        )
      }
      <a class="textLink" href={`${urlPrefix}/works/`}
        >all works <span aria-hidden="true">↗</span></a
      >
    </section>
    <section class="platform aboutInset mb-24" aria-labelledby="platformTitle">
      <h2 id="platformTitle" class="sectionLabel">
        制作体制<span class="translation" lang="en">how we work</span>
      </h2>
      <p>
        メンバーを固定せず、その時必要な人が集まりモノを作るプラットフォームです。<br />
        映像・音楽などのメディアを中心に様々なモノを作りだします。
      </p>
      <p lang="en" class="englishText translation">
        smitharia is a creative platform with no fixed membership. We bring together the people each
        project needs.<br />
        Our work spans video, music and other forms of creative media.
      </p>
    </section>
    <section aria-labelledby="membersTitle">
      <div class="aboutInset mb-16">
        <h2 id="membersTitle" class="sectionLabel">
          参加クリエイター<span class="translation" lang="en">creators</span>
        </h2>
        <p class="leading-relaxed">
          つくるものに合わせて、その都度チームを組んでいます。<br />
          ここではこれまで制作に関わってきた人たちの一部を紹介します。
        </p>
        <p class="englishText translation" lang="en">
          We assemble a team for each project.<br />
          Here are some of the people who have contributed to our work.
        </p>
      </div>
      <Members limited={limited} />
    </section>
    <section
      id="contact"
      aria-labelledby="contactHeading"
      class="mb-24 px-6 md:px-0 text-white font-serif scroll-mt-36"
    >
      <h2 id="contactHeading" class="mb-6 text-xl font-serif">
        制作のご相談<span class="translation" lang="en">contact</span>
      </h2>
      <div class="max-w-2xl leading-relaxed">
        <p>企画や制作のご相談はこちらへ。</p>
        <p class="englishText translation" lang="en">Get in touch to discuss your project.</p>
        <a
          class="inline-block mt-4 py-3 underline underline-offset-4"
          href="mailto:info@smitharia.com"
        >
          info@smitharia.com
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(.contacts) {
    position: static;
  }
  .aboutContent {
    font-weight: 400;
  }
  .sectionLabel .translation,
  #contactHeading .translation {
    display: block;
    margin-top: 8px;
  }
  .englishCredit {
    margin-top: 8px;
  }
  .englishText {
    margin-top: 16px;
    max-width: 38em;
  }
  .sectionLabel,
  #contactHeading {
    color: var(--brandRedText);
  }
  .textLink span,
  .workCaption > span {
    color: var(--brandGreen);
  }
  .textLink:hover,
  .textLink:focus-visible,
  .activityWork:hover .workCaption,
  .activityWork:focus-visible .workCaption,
  #contact a:hover,
  #contact a:focus-visible {
    color: var(--brandGreen);
  }
  .aboutIntroduction .englishText + p {
    margin-top: 24px;
  }
  .aboutHero {
    margin-bottom: 80px;
  }
  .aboutIntroduction {
    margin-bottom: 32px;
  }
  .aboutIntroduction h1 {
    font-size: clamp(24px, 2.4vw, 36px);
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .aboutIntroduction p:not(.translation) {
    font-size: 16px;
    line-height: 1.75;
    max-width: 38em;
  }
  .aboutIntroduction p span {
    display: inline-block;
  }
  .landscapeImage {
    height: clamp(220px, 25vw, 360px);
  }
  .aboutLandscape figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: 12px;
    color: #b4b4b4;
    font-size: 14px;
    line-height: 1.75;
  }
  .aboutInset {
    padding-right: clamp(24px, 4vw, 64px);
  }
  .sectionLabel {
    font-size: 16px;
    margin-bottom: 36px;
  }
  .activity {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: start;
    gap: clamp(28px, 4vw, 64px);
    border-top: 1px solid #ffffff30;
    padding: 40px 0 48px;
  }
  .activityLabel {
    display: block;
    font-size: 14px;
    margin-top: 8px;
  }
  .activity h3 {
    font-size: 20px;
    margin-bottom: 20px;
    line-height: 1.5;
  }
  .activityDescription {
    color: #f2f0eb;
    font-size: 16px;
    line-height: 1.75;
    max-width: 32em;
  }
  .activityWork:hover :global(img.normal),
  .activityWork:focus-visible :global(img.normal) {
    opacity: 0;
  }
  .activityWork {
    display: block;
  }
  .activityImage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: #161616;
  }
  .activityImage > :global(.toggle_image) {
    position: absolute;
    inset: 0;
  }
  .activityImage img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  .workCaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.75;
  }
  .workCredit:not(.translation) {
    font-size: 16px;
    color: #f2f0eb;
    margin-top: 8px;
    line-height: 1.75;
  }
  .textLink {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    min-height: 44px;
    border-bottom: 1px solid #ffffff50;
  }
  .platform {
    border-top: 1px solid #ffffff30;
    padding-top: 40px;
    line-height: 1.75;
  }
  .activityWork:hover .workCaption,
  .textLink:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 1023px) {
    .activity {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  @media (max-width: 767px) {
    .aboutHero {
      margin-bottom: 80px;
    }
    .aboutIntroduction {
      margin-bottom: 32px;
    }
    .aboutIntroduction h1 {
      font-size: clamp(24px, 2.4vw, 36px);
      line-height: 1.5;
      margin-bottom: 20px;
    }
    .aboutIntroduction p:not(.translation) {
      font-size: 16px;
      line-height: 1.75;
      max-width: 38em;
    }
    .landscapeImage {
      height: clamp(220px, 25vw, 360px);
    }
    .aboutLandscape figcaption {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 20px;
      margin-top: 12px;
      color: #b4b4b4;
      font-size: 14px;
      line-height: 1.75;
    }
    .aboutInset {
      padding-left: 24px;
      padding-right: 24px;
    }
    .aboutHero {
      margin-bottom: 56px;
    }
    .aboutIntroduction h1 {
      font-size: 24px;
    }
    .activity {
      padding: 32px 0 40px;
    }
  }
</style>
