---
import Layout from '../../layouts/Layout.astro';
import WorkDetail from '../../components/works/WorkDetail.astro';
import { getAllWorks, getWork, getCatsFromWork, getRawCats } from '../../lib/WP';

export async function getStaticPaths() {
  const works = (await getAllWorks('exclude')).filter((work) => !work.acf.limited);
  const ids = works.map((work) => {
    return { params: { id: work.id } };
  });
  return ids;
}
const { id } = Astro.params;
const work = await getWork(id);
const cats = await getRawCats();
const workCats = getCatsFromWork(work, cats);
---

<Layout title={work.title.rendered} pagename="works">
  <WorkDetail work={work} categories={workCats} />
</Layout>
