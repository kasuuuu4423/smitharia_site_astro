---
import Layout from '../../../layouts/Layout.astro';
import WorkDetail from '../../../components/works/WorkDetail.astro';
import { getWorkMetadata } from '../../../lib/WorkMetadata';
import { getAllWorks, getWork, getCatsFromWork, getRawCats } from '../../../lib/WP';

export async function getStaticPaths() {
  const works = await getAllWorks('include');
  const ids = works.map((work) => {
    return { params: { id: work.id } };
  });
  return ids;
}
const { id } = Astro.params;
const work = await getWork(id, true);
const cats = await getRawCats();
const workCats = getCatsFromWork(work, cats);
---

<Layout limited={true} {...getWorkMetadata(work)} pagename="works">
  <WorkDetail work={work} categories={workCats} />
</Layout>
