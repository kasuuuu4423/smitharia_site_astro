---
import Layout from '../../../layouts/Layout.astro';
import Members from '../../../components/aboutus/Members.astro';
import Scrollate from '../../../components/common/Scrollate.astro';
import ToggleFilteredImage from '../../../components/common/ToggleFilteredImage.astro';
import ToggleText from '../../../components/common/ToggleText.astro';
import { parentClass as imgParentClass } from '../../../components/common/ToggleFilteredImage.astro';
import { getPreference } from '../../../lib/WP';

const pref = await getPreference();
const aboutImage = pref.acf.about_image.sizes.medium_large;
const alt = pref.acf.about_image.alt;
---

<Layout limited={true} title="about us" pagename="about us">
  <main class="w-full md:pl-16">
    <div class={'mb-24 ' + imgParentClass}>
      <ToggleFilteredImage imgPath={aboutImage} alt={alt} reverse />
      <div class="px-6 md:px-0 mt-4">
        <ToggleText text="スミサリアの原風景" english="Primitive landscape of smitharia." />
      </div>
    </div>
    <div class="info mb-24 text-white font-sans px-6 md:p-0">
      <h1 class="text-center mb-10 text-2xl">
        スミサリアとは
        <div lang="en" class="en font-serif text-base mt-3 text-[#ff9292]">about smitharia</div>
      </h1>
      <div class="text-left md:text-center leading-relaxed">
        <p>
          メンバーを固定せず、その時必要な人が集まりモノを作るプラットフォームです。<br />
          映像・音楽などのメディアを中心に様々なモノを作りだします。
        </p>
        <p lang="en" class="en font-serif text-base mt-6 text-[#a8b8ff]">
          It is a platform where people who need something at that time gather and create it,
          without fixing the members.<br />
          We create a variety of products centered on media such as video and music.
        </p>
      </div>
    </div>
    <Scrollate text="member" />
    <div class="mb-24"></div>
    <Members limited={true} />
  </main>
</Layout>

<style>
  main {
  }
</style>

<script></script>
